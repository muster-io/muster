{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  rangeStrategy: 'pin',
  postUpdateOptions: [
    'gomodTidy',
  ],
  semanticCommits: 'enabled',
  semanticCommitScope: 'deps',
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/__tests__/**',
    '**/tests/**',
    '**/__fixtures__/**',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  schedule: [
    'before 6am on Monday',
  ],
  minimumReleaseAge: '3 days',
  prConcurrentLimit: 4,
  prHourlyLimit: 2,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+_VERSION(?: :=|:) (?<currentValue>\\S+)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^test/e2e/[^/]+\\.go$/',
      ],
      matchStrings: [
        '// renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*const \\w+ = "[^":]+:(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[0-9a-f]{64})"',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'PLAYWRIGHT_IMAGE\\s*[:?]?=\\s*mcr\\.microsoft\\.com/playwright:(?<currentValue>v[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'mcr.microsoft.com/playwright',
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>noble)$',
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'pinDigest',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      matchDatasources: [
        'github-actions',
      ],
      groupName: 'GitHub Actions',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pinDigest',
      ],
      groupName: 'Container images (non-major)',
    },
    {
      matchDatasources: [
        'go',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'Go modules (non-major)',
    },
    {
      matchDatasources: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'npm (non-major)',
    },
    {
      matchPackageNames: [
        '/^@tanstack\\//',
      ],
      groupName: 'TanStack',
    },
    {
      matchPackageNames: [
        'react',
        'react-dom',
        '@types/react',
        '@types/react-dom',
      ],
      groupName: 'React',
    },
    {
      matchPackageNames: [
        'oxlint',
        'oxfmt',
      ],
      groupName: 'oxlint/oxfmt',
    },
    {
      matchPackageNames: [
        '@playwright/test',
        'playwright',
        'mcr.microsoft.com/playwright',
      ],
      groupName: 'Playwright',
    },
    {
      matchPackageNames: [
        '/oapi-codegen/',
        '/orval/',
      ],
      matchDatasources: [
        'npm',
        'go',
      ],
      prBodyNotes: 'Generated code must be regenerated with `make generate` and committed.',
    },
    {
      matchDepTypes: [
        'engines',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/muster-io/muster-example-bridge',
      ],
      groupName: 'example bridge image',
      minimumReleaseAge: '0 days',
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'ghcr.io/muster-io/muster',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'require',
        'toolchain',
      ],
      semanticCommitType: 'build',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'github.com/VictoriaMetrics/metricsql',
        'github.com/pganalyze/pg_query_go/v6',
        'github.com/testcontainers/testcontainers-go',
        'github.com/testcontainers/testcontainers-go/modules/postgres',
        'github.com/wasilibs/go-pgquery',
        'go.yaml.in/yaml/v3',
        'golang.org/x/tools',
        'google.golang.org/protobuf',
      ],
      semanticCommitType: 'chore',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'indirect',
      ],
      matchJsonata: [
        'isVulnerabilityAlert = true',
      ],
      matchPackageNames: [
        'dario.cat/mergo',
        'github.com/apapsch/go-jsonmerge/v2',
        'github.com/gabriel-vasile/mimetype',
        'github.com/go-openapi/jsonpointer',
        'github.com/go-playground/locales',
        'github.com/go-playground/universal-translator',
        'github.com/google/uuid',
        'github.com/gorilla/mux',
        'github.com/jackc/pgpassfile',
        'github.com/jackc/pgservicefile',
        'github.com/jackc/puddle/v2',
        'github.com/leodido/go-urn',
        'github.com/oasdiff/yaml',
        'github.com/oasdiff/yaml3',
        'github.com/santhosh-tekuri/jsonschema/v6',
        'github.com/spf13/cast',
        'github.com/valyala/fastrand',
        'github.com/valyala/histogram',
        'golang.org/x/sync',
        'golang.org/x/sys',
        'golang.org/x/text',
      ],
      semanticCommitType: 'build',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'web/package.json',
      ],
      matchDepTypes: [
        'dependencies',
      ],
      semanticCommitType: 'build',
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      matchFileNames: [
        'Dockerfile',
      ],
      semanticCommitType: 'build',
    },
    {
      matchFileNames: [
        'internal/archlint/testdata/**',
      ],
      semanticCommitType: 'chore',
    },
    {
      matchJsonata: [
        'isLockfileUpdate = true',
      ],
      semanticCommitType: 'chore',
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 3am on Monday',
    ],
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
}
