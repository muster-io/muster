#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright The Muster Authors
"""Sync the story contracts in design/stories/ to GitHub issues.

Usage (Python 3.9+, standard library only; needs `gh`, authenticated, and git):

    scripts/stories-sync                      # dry run, the default: read GitHub and print the plan
    scripts/stories-sync --apply              # make the changes
    scripts/stories-sync --only S-001,S-002   # limit the run to these stories and their capabilities
    scripts/stories-sync --repo OWNER/NAME    # another repository (default: the `origin` remote)
    scripts/stories-sync --delay 1.0          # seconds between write requests (default 1.0)

What it does:

- one issue per capability that has stories, titled `C-NN: <title>`, label `capability`;
- one issue per story, titled `S-NNN: <title>`, labels `story`, its kind and `operator-attention`
  when set, added as a sub-issue of its capability issue; every `depends_on` entry becomes a
  "blocked by" link, so a frontend story is blocked by its backend story;
- every issue gets the milestone named after the layer (`L1`); the labels and the milestone are
  created when missing;
- existing issues are found by title prefix, open or closed, and only what differs is changed:
  title, body, the labels above, the milestone, missing links; "blocked by" links to story issues
  that `depends_on` no longer lists are removed;
- the issue of a story whose file is gone is closed as not planned, with a comment;
- the issue number is written into the `issue:` line of each story file; commit that change.

Issue bodies link to the files at the HEAD commit, so `--apply` refuses to run when a story or
capability file differs from HEAD (apart from `issue:` lines) or when HEAD is not on GitHub.
"""

from __future__ import annotations

import argparse
import hashlib
import heapq
import json
import re
import subprocess
import sys
import time
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Callable, Optional

ROOT = Path(__file__).resolve().parent.parent
STORIES_DIR = "design/stories"
CAPABILITIES_DIR = "design/prd/l1"

FOOTER = "Generated by scripts/stories-sync — edit the files, not this issue."

LABELS = [
    ("story", "1d76db", "A story: one pull request that delivers part of a capability"),
    ("capability", "5319e7", "A capability of the PRD; its stories are sub-issues"),
    ("be", "0e8a16", "Backend story: Go, SQL, OpenAPI"),
    ("fe", "fbca04", "Frontend story: the web UI"),
    ("infra", "bfd4f2", "Build, CI, release and deployment"),
    ("docs", "006b75", "The documentation site"),
    ("operator-attention", "d93f0b", "The operator has to act or decide during the story"),
]
MANAGED_LABELS = {name for name, _, _ in LABELS}
KINDS = ("be", "fe", "infra", "docs")

FRONTMATTER_KEYS = (
    "id",
    "title",
    "capability",
    "kind",
    "layer",
    "depends_on",
    "covers",
    "files_touched",
    "acceptance",
    "verify",
    "operator_attention",
    "issue",
)

TITLE_RE = re.compile(r"^(S-\d{3}|C-\d{2}):")
STORY_FILE_RE = re.compile(r"^(S-\d{3})-[a-z0-9-]+\.md$")
CAPABILITY_FILE_RE = re.compile(r"^(C-\d{2})-[a-z0-9-]+\.md$")
CAPABILITY_HEADING_RE = re.compile(r"^# (C-\d{2})\. (\S.*)$")
ISSUE_LINE_RE = re.compile(r"^issue:[^\n]*$", re.M)


class SyncError(Exception):
    pass


def log(msg: str = "") -> None:
    print(msg, flush=True)


def warn(msg: str) -> None:
    print(f"warning: {msg}", flush=True)


# --------------------------------------------------------------------------------------------
# Frontmatter: a strict parser for the YAML subset the story files use. Top-level `key: value`
# lines; values are plain scalars, double-quoted strings, `null`, `true`, `false`, integers,
# flow lists `[a, b]` and block lists of `  - item` lines. Anything else is an error.
# --------------------------------------------------------------------------------------------

PLAIN_FORBIDDEN_START = set("-?:,[]{}#&*!|>'\"%@`")
DQ_ESCAPES = {'"': '"', "\\": "\\", "/": "/", "n": "\n", "t": "\t"}
AMBIGUOUS_WORDS = {"y", "n", "yes", "no", "on", "off", "true", "false", "null", "~", ".inf", ".nan"}
NUMBER_LIKE_RE = re.compile(r"[-+]?(\.?[0-9])[0-9a-fA-FxXoObB_.:eE+-]*")
DATE_LIKE_RE = re.compile(r"[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}")


class FrontmatterError(Exception):
    pass


def _plain(token: str, where: str, flow: bool) -> Any:
    if token == "":
        raise FrontmatterError(f"{where}: empty value")
    if token in ("null", "~"):
        return None
    if token == "true":
        return True
    if token == "false":
        return False
    if re.fullmatch(r"-?[0-9]+", token):
        return int(token)
    if token.lower() in AMBIGUOUS_WORDS:
        raise FrontmatterError(f"{where}: ambiguous scalar {token!r}; quote it")
    if NUMBER_LIKE_RE.fullmatch(token) or DATE_LIKE_RE.match(token):
        raise FrontmatterError(f"{where}: number- or date-like scalar {token!r}; quote it")
    if token[0] in PLAIN_FORBIDDEN_START or token[0].isspace() or token[-1].isspace():
        raise FrontmatterError(f"{where}: unsupported plain scalar {token!r}; quote it")
    if ": " in token or " #" in token or token.endswith(":"):
        raise FrontmatterError(f"{where}: plain scalar {token!r} needs quotes")
    if flow and any(c in token for c in ",[]{}"):
        raise FrontmatterError(f"{where}: {token!r} in a flow list needs quotes")
    return token


def _double_quoted(text: str, start: int, where: str) -> tuple[str, int]:
    out = []
    i = start + 1
    while i < len(text):
        c = text[i]
        if c == '"':
            return "".join(out), i + 1
        if c == "\\":
            if i + 1 >= len(text):
                break
            e = text[i + 1]
            if e in DQ_ESCAPES:
                out.append(DQ_ESCAPES[e])
                i += 2
                continue
            if e == "u" and re.fullmatch(r"[0-9A-Fa-f]{4}", text[i + 2 : i + 6]):
                out.append(chr(int(text[i + 2 : i + 6], 16)))
                i += 6
                continue
            raise FrontmatterError(f"{where}: unsupported escape \\{e}")
        out.append(c)
        i += 1
    raise FrontmatterError(f"{where}: unterminated double-quoted string")


def _scalar(text: str, where: str) -> Any:
    if text.startswith('"'):
        value, end = _double_quoted(text, 0, where)
        if text[end:].strip():
            raise FrontmatterError(f"{where}: text after the closing quote")
        return value
    return _plain(text, where, flow=False)


def _flow_list(text: str, where: str) -> list[Any]:
    if not (text.startswith("[") and text.endswith("]")):
        raise FrontmatterError(f"{where}: malformed flow list")
    inner = text[1:-1]
    items: list[Any] = []
    i = 0
    if inner.strip() == "":
        return items
    while True:
        while i < len(inner) and inner[i] == " ":
            i += 1
        if i < len(inner) and inner[i] == '"':
            value, i = _double_quoted(inner, i, where)
            items.append(value)
            while i < len(inner) and inner[i] == " ":
                i += 1
        else:
            j = i
            while j < len(inner) and inner[j] != ",":
                j += 1
            items.append(_plain(inner[i:j].strip(), where, flow=True))
            i = j
        if i >= len(inner):
            return items
        if inner[i] != ",":
            raise FrontmatterError(f"{where}: expected ',' in flow list")
        i += 1


def parse_frontmatter(text: str, name: str) -> dict[str, Any]:
    lines = text.split("\n")
    if not lines or lines[0] != "---":
        raise FrontmatterError(f"{name}: the file does not start with '---'")
    try:
        end = lines.index("---", 1)
    except ValueError:
        raise FrontmatterError(f"{name}: no closing '---'") from None
    data: dict[str, Any] = {}
    current_list: Optional[list[Any]] = None
    current_key = ""
    for n in range(1, end):
        line = lines[n]
        where = f"{name}:{n + 1}"
        if line.strip() == "":
            continue
        if "\t" in line or "\r" in line:
            raise FrontmatterError(f"{where}: tabs and carriage returns are not supported")
        if line.startswith("  - "):
            if current_list is None:
                raise FrontmatterError(f"{where}: list item without a list key")
            current_list.append(_scalar(line[4:], where))
            continue
        if line.startswith(" "):
            raise FrontmatterError(f"{where}: unsupported indentation (multi-line values are not supported)")
        if current_list is not None and not current_list:
            data[current_key] = None
        current_list = None
        m = re.fullmatch(r"([a-z_]+):(?: (.*))?", line)
        if not m:
            raise FrontmatterError(f"{where}: expected 'key: value'")
        key, value = m.group(1), (m.group(2) or "").strip()
        if key in data:
            raise FrontmatterError(f"{where}: duplicate key {key!r}")
        if value == "":
            current_list = []
            current_key = key
            data[key] = current_list
        elif value.startswith("["):
            data[key] = _flow_list(value, where)
        else:
            data[key] = _scalar(value, where)
    if current_list is not None and not current_list:
        data[current_key] = None
    return data


# --------------------------------------------------------------------------------------------
# Stories and capabilities
# --------------------------------------------------------------------------------------------


@dataclass
class Capability:
    id: str
    title: str
    rel: str
    digest: str
    stories: list[Story] = field(default_factory=list)


@dataclass
class Story:
    id: str
    title: str
    capability: str
    kind: str
    layer: str
    depends_on: list[str]
    acceptance: list[str]
    verify: str
    operator_attention: bool
    issue: Optional[int]
    rel: str
    digest: str


def normalize_story_text(text: str) -> str:
    return ISSUE_LINE_RE.sub("issue: null", text, count=1)


def digest(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]


def load_capabilities() -> dict[str, Capability]:
    caps: dict[str, Capability] = {}
    errors = []
    for path in sorted((ROOT / CAPABILITIES_DIR).glob("C-*.md")):
        m = CAPABILITY_FILE_RE.match(path.name)
        if not m:
            errors.append(f"{path.name}: unexpected capability file name")
            continue
        text = path.read_text(encoding="utf-8")
        heading = next((ln for ln in text.split("\n") if ln.startswith("#")), "")
        h = CAPABILITY_HEADING_RE.match(heading)
        if not h or h.group(1) != m.group(1):
            errors.append(f"{path.name}: the first heading must be '# {m.group(1)}. <title>'")
            continue
        if m.group(1) in caps:
            errors.append(f"{path.name}: duplicate capability {m.group(1)}")
            continue
        caps[m.group(1)] = Capability(
            id=m.group(1),
            title=h.group(2).strip(),
            rel=f"{CAPABILITIES_DIR}/{path.name}",
            digest=digest(text),
        )
    if errors:
        raise SyncError("capability files are invalid:\n  " + "\n  ".join(errors))
    return caps


def _str_list(fm: dict[str, Any], key: str, pattern: Optional[str], errors: list[str], name: str) -> list[str]:
    value = fm.get(key)
    if not isinstance(value, list) or not all(isinstance(v, str) and v for v in value):
        errors.append(f"{name}: {key} must be a list of strings")
        return []
    if pattern:
        bad = [v for v in value if not re.fullmatch(pattern, v)]
        if bad:
            errors.append(f"{name}: {key} has invalid entries {bad}")
    if len(set(value)) != len(value):
        errors.append(f"{name}: {key} has duplicate entries")
    return value


def load_stories(caps: dict[str, Capability]) -> dict[str, Story]:
    stories: dict[str, Story] = {}
    errors: list[str] = []
    for path in sorted((ROOT / STORIES_DIR).glob("S-*.md")):
        name = path.name
        m = STORY_FILE_RE.match(name)
        if not m:
            errors.append(f"{name}: unexpected story file name")
            continue
        text = path.read_text(encoding="utf-8")
        try:
            fm = parse_frontmatter(text, name)
        except FrontmatterError as exc:
            errors.append(str(exc))
            continue
        missing = [k for k in FRONTMATTER_KEYS if k not in fm]
        unknown = [k for k in fm if k not in FRONTMATTER_KEYS]
        if missing or unknown:
            errors.append(f"{name}: missing keys {missing}, unknown keys {unknown}")
            continue
        n_err = len(errors)
        if fm["id"] != m.group(1):
            errors.append(f"{name}: id {fm['id']!r} does not match the file name")
        title = fm["title"]
        if not isinstance(title, str) or not title.strip():
            errors.append(f"{name}: title must be a non-empty string")
            title = ""
        kind = fm["kind"]
        if kind not in KINDS:
            errors.append(f"{name}: kind must be one of {KINDS}")
        suffix = {"be": "(BE)", "fe": "(FE)"}.get(kind)
        if suffix and not title.endswith(suffix):
            errors.append(f"{name}: a {kind} story title ends with {suffix}")
        if not suffix and re.search(r"\((BE|FE)\)$", title):
            errors.append(f"{name}: only be and fe story titles end with (BE) or (FE)")
        if not (isinstance(fm["capability"], str) and fm["capability"] in caps):
            errors.append(f"{name}: capability {fm['capability']!r} has no file in {CAPABILITIES_DIR}")
        if not (isinstance(fm["layer"], str) and re.fullmatch(r"L\d+", fm["layer"])):
            errors.append(f"{name}: layer must look like L1")
        depends_on = _str_list(fm, "depends_on", r"S-\d{3}", errors, name)
        _str_list(fm, "covers", r"C-\d{2}\.(FR|AC)-\d+", errors, name)
        _str_list(fm, "files_touched", None, errors, name)
        acceptance = _str_list(fm, "acceptance", None, errors, name)
        if not acceptance:
            errors.append(f"{name}: acceptance must not be empty")
        verify = fm["verify"]
        if not (isinstance(verify, str) and verify.startswith("make")):
            errors.append(f"{name}: verify must be a string starting with 'make'")
        if not isinstance(fm["operator_attention"], bool):
            errors.append(f"{name}: operator_attention must be true or false")
        issue = fm["issue"]
        if issue is not None and not (isinstance(issue, int) and not isinstance(issue, bool) and issue > 0):
            errors.append(f"{name}: issue must be null or a positive number")
        if len(errors) > n_err:
            continue
        stories[fm["id"]] = Story(
            id=fm["id"],
            title=title,
            capability=fm["capability"],
            kind=kind,
            layer=fm["layer"],
            depends_on=depends_on,
            acceptance=acceptance,
            verify=verify,
            operator_attention=fm["operator_attention"],
            issue=issue,
            rel=f"{STORIES_DIR}/{name}",
            digest=digest(normalize_story_text(text)),
        )
    for s in stories.values():
        for d in s.depends_on:
            if d == s.id:
                errors.append(f"{s.id}: depends on itself")
            elif d not in stories:
                errors.append(f"{s.id}: depends on {d}, which has no story file")
    if errors:
        raise SyncError("story files are invalid:\n  " + "\n  ".join(errors))
    for s in stories.values():
        caps[s.capability].stories.append(s)
    return stories


def topological_order(stories: dict[str, Story]) -> list[str]:
    indegree = {sid: len(s.depends_on) for sid, s in stories.items()}
    dependents: dict[str, list[str]] = {sid: [] for sid in stories}
    for s in stories.values():
        for d in s.depends_on:
            dependents[d].append(s.id)
    ready = [sid for sid, n in indegree.items() if n == 0]
    heapq.heapify(ready)
    order = []
    while ready:
        sid = heapq.heappop(ready)
        order.append(sid)
        for nxt in dependents[sid]:
            indegree[nxt] -= 1
            if indegree[nxt] == 0:
                heapq.heappush(ready, nxt)
    if len(order) != len(stories):
        cyclic = sorted(sid for sid, n in indegree.items() if n > 0)
        raise SyncError(f"depends_on has a cycle among {', '.join(cyclic)}")
    return order


def check_frontend_dependencies(stories: dict[str, Story]) -> None:
    def ancestors(sid: str, seen: set[str]) -> set[str]:
        for d in stories[sid].depends_on:
            if d not in seen:
                seen.add(d)
                ancestors(d, seen)
        return seen

    errors = []
    for s in stories.values():
        if s.kind != "fe":
            continue
        backend = {o.id for o in stories.values() if o.capability == s.capability and o.kind == "be"}
        if backend and not backend & ancestors(s.id, set()):
            errors.append(f"{s.id}: a frontend story must depend on a backend story of {s.capability}")
    if errors:
        raise SyncError("\n  ".join(["dependency rule broken:"] + errors))


# --------------------------------------------------------------------------------------------
# GitHub, through `gh api`
# --------------------------------------------------------------------------------------------


class GitHubError(SyncError):
    pass


class GitHub:
    MAX_ATTEMPTS = 6

    def __init__(self, repo: str, delay: float):
        self.repo = repo
        self.delay = delay
        self._last = 0.0
        self.reads = 0
        self.writes = 0

    def _pace(self, write: bool) -> None:
        interval = self.delay if write else self.delay / 4
        wait = self._last + interval - time.monotonic()
        if wait > 0:
            time.sleep(wait)
        self._last = time.monotonic()

    @staticmethod
    def _parse(stdout: str) -> tuple[Optional[int], dict[str, str], str]:
        lines = stdout.split("\n")
        if not lines or not lines[0].startswith("HTTP/"):
            return None, {}, stdout
        status = int(lines[0].split()[1])
        headers: dict[str, str] = {}
        i = 1
        while i < len(lines) and lines[i].strip() != "":
            key, _, value = lines[i].partition(":")
            headers[key.strip().lower()] = value.strip()
            i += 1
        return status, headers, "\n".join(lines[i + 1 :])

    @staticmethod
    def _retry_after(status: int, headers: dict[str, str], message: str, attempt: int) -> Optional[float]:
        if status not in (403, 429):
            return None
        if headers.get("retry-after", "").isdigit():
            return float(headers["retry-after"]) + 1
        if headers.get("x-ratelimit-remaining") == "0" and headers.get("x-ratelimit-reset", "").isdigit():
            return max(float(headers["x-ratelimit-reset"]) - time.time(), 0) + 2
        if status == 429 or "rate limit" in message.lower():
            return min(60.0 * 2**attempt, 900.0)
        return None

    def request(self, method: str, path: str, data: Any = None, allow: tuple[int, ...] = ()) -> tuple[int, Any]:
        write = method != "GET"
        args = [
            "gh",
            "api",
            "--include",
            "--method",
            method,
            path,
            "-H",
            "Accept: application/vnd.github+json",
            "-H",
            "X-GitHub-Api-Version: 2022-11-28",
        ]
        payload = None
        if data is not None:
            args += ["--input", "-"]
            payload = json.dumps(data)
        for attempt in range(self.MAX_ATTEMPTS):
            self._pace(write)
            if write:
                self.writes += 1
            else:
                self.reads += 1
            proc = subprocess.run(args, input=payload, capture_output=True, text=True)
            status, headers, body = self._parse(proc.stdout)
            if status is None:
                raise GitHubError(f"{method} {path}: gh failed: {proc.stderr.strip() or proc.stdout.strip()}")
            try:
                parsed = json.loads(body) if body.strip() else None
            except json.JSONDecodeError:
                parsed = None
            if 200 <= status < 300 or status in allow:
                return status, parsed
            message = parsed.get("message", "") if isinstance(parsed, dict) else body.strip()
            if isinstance(parsed, dict) and parsed.get("errors"):
                message += f" {json.dumps(parsed['errors'])}"
            wait = self._retry_after(status, headers, message, attempt)
            if wait is None and status >= 500 and not write:
                wait = 5.0 * 2**attempt
            if wait is None or attempt == self.MAX_ATTEMPTS - 1:
                raise GitHubError(f"{method} {path}: HTTP {status}: {message}")
            warn(f"{method} {path}: HTTP {status} ({message}); retrying in {wait:.0f} s")
            time.sleep(wait)
        raise GitHubError(f"{method} {path}: gave up")

    def get(self, path: str, allow: tuple[int, ...] = ()) -> tuple[int, Any]:
        return self.request("GET", path, allow=allow)

    def get_all(self, path: str) -> list[Any]:
        sep = "&" if "?" in path else "?"
        items: list[Any] = []
        page = 1
        while True:
            _, data = self.get(f"{path}{sep}per_page=100&page={page}")
            if not isinstance(data, list):
                raise GitHubError(f"GET {path}: expected a list")
            items.extend(data)
            if len(data) < 100:
                return items
            page += 1


@dataclass
class Issue:
    number: Optional[int]
    id: Optional[int]
    title: str
    body: str
    state: str
    state_reason: Optional[str]
    labels: list[str]
    milestone: Optional[str]
    blocked_by_total: Optional[int]
    sub_issues_total: Optional[int]
    created_now: bool = False

    @classmethod
    def from_api(cls, raw: dict[str, Any], created_now: bool = False) -> Issue:
        deps = raw.get("issue_dependencies_summary") or {}
        subs = raw.get("sub_issues_summary") or {}
        return cls(
            number=raw["number"],
            id=raw["id"],
            title=raw["title"],
            body=raw.get("body") or "",
            state=raw["state"],
            state_reason=raw.get("state_reason"),
            labels=[lb["name"] for lb in raw.get("labels", [])],
            milestone=(raw.get("milestone") or {}).get("title"),
            blocked_by_total=deps.get("total_blocked_by", deps.get("blocked_by")),
            sub_issues_total=subs.get("total"),
            created_now=created_now,
        )

    @property
    def ref(self) -> str:
        return f"#{self.number}" if self.number else "(new)"


# --------------------------------------------------------------------------------------------
# Issue bodies
# --------------------------------------------------------------------------------------------

CODE_SPAN_RE = re.compile(r"(`+)(.+?)\1")
MENTION_RE = re.compile(r"(?<![\w`./-])@([A-Za-z0-9][A-Za-z0-9_-]*)")


def _escape_text(text: str) -> str:
    text = text.replace("<", "&lt;")
    return MENTION_RE.sub(r"`@\1`", text)


def md(text: str) -> str:
    """Markdown-safe inline text: no raw HTML and no @-mentions outside code spans."""
    out = []
    pos = 0
    for m in CODE_SPAN_RE.finditer(text):
        out.append(_escape_text(text[pos : m.start()]))
        out.append(m.group(0))
        pos = m.end()
    out.append(_escape_text(text[pos:]))
    return "".join(out)


def normalize_body(body: str) -> str:
    body = body.replace("\r\n", "\n")
    body = re.sub(r"/blob/[0-9a-f]{40}/", "/blob/HEAD/", body)
    body = re.sub(r"^- \[[xX]\] ", "- [ ] ", body, flags=re.M)
    return "\n".join(line.rstrip() for line in body.strip().split("\n"))


def keep_ticks(old: str, new: str) -> str:
    ticked = {m.group(1) for m in re.finditer(r"^- \[[xX]\] (.*?)\s*$", old.replace("\r\n", "\n"), re.M)}
    return re.sub(
        r"^- \[ \] (.*)$",
        lambda m: f"- [x] {m.group(1)}" if m.group(1) in ticked else m.group(0),
        new,
        flags=re.M,
    )


# --------------------------------------------------------------------------------------------
# The sync
# --------------------------------------------------------------------------------------------


class Sync:
    def __init__(
        self,
        gh: GitHub,
        apply: bool,
        sha: str,
        caps: dict[str, Capability],
        stories: dict[str, Story],
        order: list[str],
        only: Optional[set[str]],
    ):
        self.gh = gh
        self.repo = gh.repo
        self.apply = apply
        self.sha = sha
        self.caps = caps
        self.stories = stories
        self.order = order
        self.only = only
        self.counts: Counter[str] = Counter()
        self.labels: set[str] = set()
        self.milestones: dict[str, Optional[int]] = {}
        self.issues: dict[str, Issue] = {}
        self.show_body = False

    # -- helpers ---------------------------------------------------------------------------

    def act(self, counter: str, message: str, fn: Callable[[], Any]) -> Any:
        self.counts[counter] += 1
        log(f"  {'' if self.apply else '[dry-run] '}{message}")
        if self.apply:
            return fn()
        return None

    def blob(self, rel: str) -> str:
        return f"https://github.com/{self.repo}/blob/{self.sha}/{rel}"

    def selected_stories(self) -> list[Story]:
        return [self.stories[sid] for sid in sorted(self.stories) if self.only is None or sid in self.only]

    def selected_capabilities(self) -> list[Capability]:
        wanted = {s.capability for s in self.selected_stories()}
        return [self.caps[cid] for cid in sorted(wanted)]

    # -- reading GitHub ---------------------------------------------------------------------

    def load(self) -> None:
        log(f"reading {self.repo}")
        self.labels = {lb["name"].lower() for lb in self.gh.get_all(f"repos/{self.repo}/labels")}
        for ms in self.gh.get_all(f"repos/{self.repo}/milestones?state=all"):
            self.milestones[ms["title"]] = ms["number"]
        raw_issues = [i for i in self.gh.get_all(f"repos/{self.repo}/issues?state=all") if "pull_request" not in i]
        duplicates: dict[str, list[int]] = {}
        for raw in raw_issues:
            m = TITLE_RE.match(raw["title"])
            if not m or raw.get("state_reason") == "duplicate":
                continue
            key = m.group(1)
            duplicates.setdefault(key, []).append(raw["number"])
            self.issues[key] = Issue.from_api(raw)
        clashes = {k: v for k, v in duplicates.items() if len(v) > 1}
        if clashes:
            detail = ", ".join(f"{k}: {' '.join(f'#{n}' for n in sorted(v))}" for k, v in sorted(clashes.items()))
            raise SyncError(f"several issues carry the same ID; close the extra ones as duplicates: {detail}")
        log(f"  {len(raw_issues)} issues in total, {len(self.issues)} with an S-NNN: or C-NN: title")

    # -- labels and milestone --------------------------------------------------------------

    def ensure_labels(self) -> None:
        log("labels")
        for name, color, description in LABELS:
            if name.lower() in self.labels:
                self.counts["label present"] += 1
                continue
            self.act(
                "label create",
                f"create label {name}",
                lambda n=name, c=color, d=description: self.gh.request(
                    "POST", f"repos/{self.repo}/labels", {"name": n, "color": c, "description": d}
                ),
            )

    def ensure_milestones(self) -> None:
        log("milestones")
        for layer in sorted({s.layer for s in self.selected_stories()}):
            if layer in self.milestones:
                self.counts["milestone present"] += 1
                continue
            result = self.act(
                "milestone create",
                f"create milestone {layer}",
                lambda t=layer: self.gh.request(
                    "POST", f"repos/{self.repo}/milestones", {"title": t, "description": f"Release {t} of Muster"}
                ),
            )
            self.milestones[layer] = result[1]["number"] if result else None

    # -- issues ----------------------------------------------------------------------------

    def story_body(self, s: Story) -> str:
        cap = self.caps[s.capability]
        lines = [
            f"- **Story file:** [`{s.rel}`]({self.blob(s.rel)})",
            f"- **Capability:** {cap.id} · {md(cap.title)} ([PRD]({self.blob(cap.rel)}))",
            f"- **Kind:** `{s.kind}` · **Depends on:** {', '.join(s.depends_on) if s.depends_on else 'nothing'}",
        ]
        if s.operator_attention:
            lines.append("- **Operator attention:** the operator acts or decides during this story; the Notes say why.")
        lines += ["", "### Acceptance", ""]
        lines += [f"- [ ] {md(a)}" for a in s.acceptance]
        lines += ["", "### Verify", "", "```sh", s.verify, "```"]
        lines += ["", "---", "", FOOTER, f"<!-- stories-sync {s.id} sha256:{s.digest} -->"]
        return "\n".join(lines) + "\n"

    def capability_body(self, c: Capability) -> str:
        position = {sid: i for i, sid in enumerate(self.order)}
        lines = [f"- **PRD:** [`{c.rel}`]({self.blob(c.rel)})", "", "### Stories", ""]
        for s in sorted(c.stories, key=lambda st: position[st.id]):
            issue = self.issues.get(s.id)
            ref = f"#{issue.number} " if issue and issue.number else ""
            lines.append(f"- {ref}{s.id} · {md(s.title)} · `{s.kind}`")
        lines += ["", "---", "", FOOTER, f"<!-- stories-sync {c.id} sha256:{c.digest} -->"]
        return "\n".join(lines) + "\n"

    def print_body(self, body: str) -> None:
        if self.show_body:
            log("\n".join(f"      | {line}" for line in body.rstrip("\n").split("\n")))

    def sync_issue(self, key: str, kind: str, title: str, body: str, labels: set[str], layer: str) -> None:
        milestone = self.milestones.get(layer)
        existing = self.issues.get(key)
        if existing is None:
            payload: dict[str, Any] = {"title": title, "body": body, "labels": sorted(labels)}
            if milestone:
                payload["milestone"] = milestone

            def create() -> None:
                _, raw = self.gh.request("POST", f"repos/{self.repo}/issues", payload)
                self.issues[key] = Issue.from_api(raw, created_now=True)
                log(f"    created #{raw['number']}")

            self.act(f"{kind} create", f"create {kind} issue {title!r} labels={','.join(sorted(labels))}", create)
            self.print_body(body)
            if not self.apply:
                self.issues[key] = Issue(None, None, title, body, "open", None, sorted(labels), layer, 0, 0, True)
            return
        changes: dict[str, Any] = {}
        what = []
        if existing.title != title:
            changes["title"] = title
            what.append("title")
        if normalize_body(existing.body) != normalize_body(body):
            changes["body"] = keep_ticks(existing.body, body)
            what.append("body")
        current_managed = {lb.lower() for lb in existing.labels if lb.lower() in MANAGED_LABELS}
        if current_managed != labels:
            changes["labels"] = sorted({lb for lb in existing.labels if lb.lower() not in MANAGED_LABELS} | labels)
            what.append("labels")
        if existing.milestone != layer:
            if milestone:
                changes["milestone"] = milestone
            what.append("milestone")
        if existing.state == "closed" and existing.state_reason == "not_planned":
            warn(f"{key}: issue {existing.ref} is closed as not planned, but its file exists; reopen it by hand")
        if not what:
            self.counts[f"{kind} unchanged"] += 1
            return

        def update() -> None:
            _, raw = self.gh.request("PATCH", f"repos/{self.repo}/issues/{existing.number}", changes)
            self.issues[key] = Issue.from_api(raw)

        self.act(f"{kind} update", f"update {kind} issue {existing.ref} {key}: {', '.join(what)}", update)
        if "body" in changes:
            self.print_body(changes["body"])

    def sync_stories(self) -> None:
        log("story issues")
        for s in self.selected_stories():
            if s.id not in self.issues and s.issue is not None:
                raise SyncError(
                    f"{s.id}: the file says issue: {s.issue}, but no issue is titled '{s.id}: ...'; "
                    "fix the title of the issue or the issue: line by hand"
                )
            existing = self.issues.get(s.id)
            if existing and s.issue is not None and s.issue != existing.number:
                warn(f"{s.id}: the file says issue: {s.issue}, but {existing.ref} has the title; using {existing.ref}")
            labels = {"story", s.kind} | ({"operator-attention"} if s.operator_attention else set())
            self.sync_issue(s.id, "story", f"{s.id}: {s.title}", self.story_body(s), labels, s.layer)

    def sync_capabilities(self) -> None:
        log("capability issues")
        for c in self.selected_capabilities():
            layers = {s.layer for s in c.stories}
            if len(layers) != 1:
                raise SyncError(f"{c.id}: its stories have different layers {sorted(layers)}")
            title = f"{c.id}: {c.title}"
            self.sync_issue(c.id, "capability", title, self.capability_body(c), {"capability"}, layers.pop())

    # -- links -----------------------------------------------------------------------------

    def sync_sub_issues(self) -> None:
        log("sub-issues")
        children: dict[str, set[int]] = {}
        selected = {s.id for s in self.selected_stories()}
        for sid in self.order:
            if sid not in selected:
                continue
            s = self.stories[sid]
            parent = self.issues.get(s.capability)
            child = self.issues.get(sid)
            if not parent or not child:
                raise SyncError(f"{sid}: missing issue for the sub-issue link")
            if parent.number is None or child.number is None:
                self.act("sub-issue add", f"add {sid} as a sub-issue of {s.capability}", lambda: None)
                continue
            if s.capability not in children:
                ids: set[int] = set()
                if not parent.created_now and parent.sub_issues_total != 0:
                    path = f"repos/{self.repo}/issues/{parent.number}/sub_issues"
                    ids = {i["id"] for i in self.gh.get_all(path)}
                children[s.capability] = ids
            if child.id in children[s.capability]:
                self.counts["sub-issue present"] += 1
                continue
            payload: dict[str, Any] = {"sub_issue_id": child.id}
            note = ""
            if not child.created_now:
                status, current = self.gh.get(f"repos/{self.repo}/issues/{child.number}/parent", allow=(404,))
                if status == 200 and isinstance(current, dict):
                    payload["replace_parent"] = True
                    note = f" (moving it from #{current['number']})"
            self.act(
                "sub-issue add",
                f"add {sid} {child.ref} as a sub-issue of {s.capability} {parent.ref}{note}",
                lambda p=parent.number, d=payload: self.gh.request(
                    "POST", f"repos/{self.repo}/issues/{p}/sub_issues", d
                ),
            )
            if child.id is not None:
                children[s.capability].add(child.id)

    def sync_blocked_by(self) -> None:
        log("blocked-by links")
        repo_url = f"https://api.github.com/repos/{self.repo}".lower()
        for s in self.selected_stories():
            issue = self.issues[s.id]
            current: dict[int, dict[str, Any]] = {}
            if issue.number is not None and not issue.created_now and issue.blocked_by_total != 0:
                path = f"repos/{self.repo}/issues/{issue.number}/dependencies/blocked_by"
                current = {i["id"]: i for i in self.gh.get_all(path)}
            for dep in s.depends_on:
                blocker = self.issues.get(dep)
                if blocker is None:
                    warn(f"{s.id}: {dep} has no issue yet; its blocked-by link waits for a run that includes it")
                    self.counts["blocked-by skipped"] += 1
                    continue
                if blocker.id is not None and blocker.id in current:
                    self.counts["blocked-by present"] += 1
                    continue
                self.act(
                    "blocked-by add",
                    f"mark {s.id} {issue.ref} as blocked by {dep} {blocker.ref}",
                    lambda n=issue.number, b=blocker: self.gh.request(
                        "POST", f"repos/{self.repo}/issues/{n}/dependencies/blocked_by", {"issue_id": b.id}
                    ),
                )
            for blocker_id, raw in current.items():
                m = TITLE_RE.match(raw.get("title", ""))
                same_repo = str(raw.get("repository_url", "")).lower() == repo_url
                if not same_repo or not m or not m.group(1).startswith("S-") or m.group(1) in s.depends_on:
                    continue
                self.act(
                    "blocked-by remove",
                    f"remove blocked-by {m.group(1)} #{raw['number']} from {s.id} {issue.ref}",
                    lambda n=issue.number, b=blocker_id: self.gh.request(
                        "DELETE", f"repos/{self.repo}/issues/{n}/dependencies/blocked_by/{b}"
                    ),
                )

    # -- dropped stories -------------------------------------------------------------------

    def close_dropped(self) -> None:
        log("dropped stories")
        if self.only is not None:
            log("  skipped with --only")
            return
        with_stories = {c.id for c in self.caps.values() if c.stories}
        for key, issue in sorted(self.issues.items()):
            if issue.state != "open" or issue.number is None:
                continue
            if key.startswith("S-") and key not in self.stories:
                reason = (
                    f"The story file of {key} is no longer in `{STORIES_DIR}/`, so this issue is closed as not "
                    f"planned. The story map in `{STORIES_DIR}/README.md` says what replaced it."
                )
            elif key.startswith("C-") and key not in with_stories:
                reason = f"{key} has no stories any more, so this issue is closed as not planned."
            else:
                continue

            def close(n: int = issue.number, text: str = reason) -> None:
                self.gh.request("POST", f"repos/{self.repo}/issues/{n}/comments", {"body": f"{text}\n\n{FOOTER}"})
                self.gh.request(
                    "PATCH", f"repos/{self.repo}/issues/{n}", {"state": "closed", "state_reason": "not_planned"}
                )

            self.act("close", f"close {key} {issue.ref} as not planned", close)

    # -- issue numbers back into the files -------------------------------------------------

    def write_back(self) -> None:
        log("issue: lines")
        for s in self.selected_stories():
            issue = self.issues.get(s.id)
            if issue is None or issue.number is None:
                if not self.apply and issue is not None:
                    self.counts["issue line write"] += 1
                continue
            if s.issue == issue.number:
                self.counts["issue line current"] += 1
                continue
            self.act(
                "issue line write",
                f"write issue: {issue.number} into {s.rel}",
                lambda p=ROOT / s.rel, n=issue.number: write_issue_line(p, n),
            )
            s.issue = issue.number

    def run(self) -> None:
        self.load()
        try:
            self.ensure_labels()
            self.ensure_milestones()
            self.sync_stories()
            self.sync_capabilities()
            self.sync_sub_issues()
            self.sync_blocked_by()
            self.close_dropped()
        finally:
            if self.apply:
                self.write_back()
        if not self.apply:
            self.write_back()


def write_issue_line(path: Path, number: int) -> None:
    data = path.read_bytes()
    end = data.index(b"\n---\n", 3) + 1
    head = data[:end]
    matches = list(re.finditer(rb"^issue:[^\n]*$", head, re.M))
    if len(matches) != 1:
        raise SyncError(f"{path.name}: expected exactly one issue: line in the frontmatter")
    m = matches[0]
    new = head[: m.start()] + f"issue: {number}".encode() + head[m.end() :] + data[end:]
    if new != data:
        path.write_bytes(new)


# --------------------------------------------------------------------------------------------
# Git checks and the command line
# --------------------------------------------------------------------------------------------


def git(*args: str) -> str:
    proc = subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True)
    if proc.returncode != 0:
        raise SyncError(f"git {' '.join(args)}: {proc.stderr.strip()}")
    return proc.stdout


def default_repo() -> str:
    url = git("remote", "get-url", "origin").strip()
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$", url)
    if not m:
        raise SyncError(f"cannot read a GitHub repository from the origin remote {url!r}; pass --repo")
    return m.group(1)


def files_differing_from_head() -> list[str]:
    paths = set(git("diff", "--name-only", "HEAD", "--", STORIES_DIR, CAPABILITIES_DIR).split())
    untracked = set(git("ls-files", "--others", "--exclude-standard", "--", STORIES_DIR, CAPABILITIES_DIR).split())
    problems = []
    for rel in sorted(paths | untracked):
        name = Path(rel).name
        if not (STORY_FILE_RE.match(name) or CAPABILITY_FILE_RE.match(name)):
            continue
        if rel in untracked or not (ROOT / rel).exists():
            problems.append(rel)
            continue
        current = (ROOT / rel).read_text(encoding="utf-8")
        committed = git("show", f"HEAD:{rel}")
        if STORY_FILE_RE.match(name):
            current, committed = normalize_story_text(current), normalize_story_text(committed)
        if current != committed:
            problems.append(rel)
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Sync design/stories/ to GitHub issues (dry run unless --apply).",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="read GitHub and print the plan (the default)")
    mode.add_argument("--apply", action="store_true", help="create and update issues, links, labels and milestones")
    parser.add_argument("--only", help="comma-separated story IDs, e.g. S-001,S-002")
    parser.add_argument("--repo", help="OWNER/NAME (default: the origin remote)")
    parser.add_argument("--delay", type=float, default=1.0, help="seconds between write requests (default 1.0)")
    parser.add_argument("--show-body", action="store_true", help="print the body of every issue created or updated")
    args = parser.parse_args()

    try:
        caps = load_capabilities()
        stories = load_stories(caps)
        order = topological_order(stories)
        check_frontend_dependencies(stories)
        only: Optional[set[str]] = None
        if args.only:
            only = {x.strip() for x in args.only.split(",") if x.strip()}
            unknown = sorted(x for x in only if x not in stories)
            if unknown:
                raise SyncError(f"--only: no story files for {', '.join(unknown)}")
        with_stories = sum(1 for c in caps.values() if c.stories)
        log(f"parsed {len(stories)} stories and {len(caps)} capabilities ({with_stories} with stories)")

        repo = args.repo or default_repo()
        sha = git("rev-parse", "HEAD").strip()
        gh = GitHub(repo, args.delay)
        log(f"{'APPLY' if args.apply else 'DRY RUN (pass --apply to make changes)'}: {repo} at {sha[:12]}")

        problems = [f"{rel} differs from HEAD" for rel in files_differing_from_head()]
        status, _ = gh.get(f"repos/{repo}/commits/{sha}", allow=(404, 422))
        if status != 200:
            problems.append(f"HEAD {sha[:12]} is not on GitHub")
        if problems and args.apply:
            raise SyncError("issue bodies link to HEAD; commit and push first:\n  " + "\n  ".join(problems))
        for p in problems:
            warn(f"{p}; --apply would refuse to run")

        sync = Sync(gh, args.apply, sha, caps, stories, order, only)
        sync.show_body = args.show_body
        failure: Optional[BaseException] = None
        try:
            sync.run()
        except SyncError as exc:
            failure = exc
        print_summary(sync, gh)
        if failure:
            raise failure
        return 0
    except SyncError as exc:
        print(f"error: {exc}", file=sys.stderr, flush=True)
        return 1
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


def print_summary(sync: Sync, gh: GitHub) -> None:
    c = sync.counts
    verb = "done" if sync.apply else "planned"
    rows = [
        ("labels", f"create {c['label create']}, present {c['label present']}"),
        ("milestones", f"create {c['milestone create']}, present {c['milestone present']}"),
        (
            "capability issues",
            f"create {c['capability create']}, update {c['capability update']}, unchanged {c['capability unchanged']}",
        ),
        ("story issues", f"create {c['story create']}, update {c['story update']}, unchanged {c['story unchanged']}"),
        ("sub-issue links", f"add {c['sub-issue add']}, present {c['sub-issue present']}"),
        (
            "blocked-by links",
            f"add {c['blocked-by add']}, remove {c['blocked-by remove']}, present {c['blocked-by present']}, "
            f"skipped {c['blocked-by skipped']}",
        ),
        ("issues to close", f"{c['close']}"),
        ("issue: lines", f"write {c['issue line write']}, current {c['issue line current']}"),
        ("GitHub requests", f"{gh.reads} reads, {gh.writes} writes"),
    ]
    log(f"summary ({verb}):")
    for name, value in rows:
        log(f"  {name:<18} {value}")


if __name__ == "__main__":
    sys.exit(main())
