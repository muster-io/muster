# Copy this file to .env next to docker-compose.yml and replace every REPLACE-ME value.

# The master keys. Muster refuses to start until the placeholder is replaced with the output of:
# openssl rand -base64 32
MUSTER_SECRET_KEYS=REPLACE-ME-with-openssl-rand-base64-32

# The address users open; links in messages point to it.
MUSTER_PUBLIC_URL=http://localhost:8080

# The bootstrap Admin: its email is also its login; the password has at least 12 characters.
MUSTER_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
MUSTER_BOOTSTRAP_ADMIN_PASSWORD=

# The PostgreSQL password, used by both containers. Change it before the first start.
POSTGRES_PASSWORD=REPLACE-ME-database-password
