          "legendFormat": "backlog",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Alerts resolved by reason",
      "description": "Alerts resolved per second, by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
