{
  "uid": "muster",
  "title": "Muster",
  "description": "Muster's Alert Groups, ingestion, delivery and platform, from the metrics of its replicas.",
  "tags": [
    "muster"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(muster_build_info, namespace)",
        "definition": "label_values(muster_build_info, namespace)",
        "regex": "",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(muster_build_info{namespace=~\"$namespace\"}, job)",
        "definition": "label_values(muster_build_info{namespace=~\"$namespace\"}, job)",
        "regex": "",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "integration",
        "label": "Integration",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "query_result(max by (integration, name) (muster_integration_info{namespace=~\"$namespace\", job=~\"$job\"}))",
        "definition": "query_result(max by (integration, name) (muster_integration_info{namespace=~\"$namespace\", job=~\"$job\"}))",
        "regex": "/integration=\"(?<value>[^\"]*)\".*name=\"(?<text>[^\"]*)\"/",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 5,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "query_result(max by (route, name) (muster_route_info{namespace=~\"$namespace\", job=~\"$job\"}))",
        "definition": "query_result(max by (route, name) (muster_route_info{namespace=~\"$namespace\", job=~\"$job\"}))",
        "regex": "/name=\"(?<text>[^\"]*)\".*route=\"(?<value>[^\"]*)\"/",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 5,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "destination",
        "label": "Destination",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "query_result(max by (destination, name) (muster_destination_info{namespace=~\"$namespace\", job=~\"$job\"}))",
        "definition": "query_result(max by (destination, name) (muster_destination_info{namespace=~\"$namespace\", job=~\"$job\"}))",
        "regex": "/destination=\"(?<value>[^\"]*)\".*name=\"(?<text>[^\"]*)\"/",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 5,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Open Alert Groups by status",
      "description": "Open Alert Groups of the selected Routes by status, counted by the Leader.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (max by (route, status) (muster_alert_groups{namespace=~\"$namespace\", job=~\"$job\", route=~\"$route\"}))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "New Alert Groups by Route",
      "description": "Alert Groups that started in each interval, by Route.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (route) (increase(muster_alert_groups_created_total{namespace=~\"$namespace\", job=~\"$job\", route=~\"$route\"}[$__rate_interval])) * on (route) group_left (name) topk by (route) (1, max by (route, name) (muster_route_info{namespace=~\"$namespace\", job=~\"$job\"}))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Time to acknowledge",
      "description": "Median and 95th percentile of the time from the start of an Alert Group to its first acknowledgement, over the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(muster_alert_group_time_to_ack_seconds_bucket{namespace=~\"$namespace\", job=~\"$job\", route=~\"$route\"}[$__range])))",
          "legendFormat": "p50",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(muster_alert_group_time_to_ack_seconds_bucket{namespace=~\"$namespace\", job=~\"$job\", route=~\"$route\"}[$__range])))",
          "legendFormat": "p95",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Time to resolve",
      "description": "Median and 95th percentile of the time from the start of an Alert Group to its resolution, over the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(muster_alert_group_time_to_resolve_seconds_bucket{namespace=~\"$namespace\", job=~\"$job\", route=~\"$route\"}[$__range])))",
          "legendFormat": "p50",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(muster_alert_group_time_to_resolve_seconds_bucket{namespace=~\"$namespace\", job=~\"$job\", route=~\"$route\"}[$__range])))",
          "legendFormat": "p95",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Delivery latency p95 against 5 seconds",
      "description": "95th percentile of the time from receiving a Snapshot to delivering its change; the line is the objective of 5 seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(muster_delivery_latency_seconds_bucket{namespace=~\"$namespace\", job=~\"$job\", destination=~\"$destination\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Active Storms",
      "description": "1 while a Route is in a Storm.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (route) (muster_storm_active{namespace=~\"$namespace\", job=~\"$job\", route=~\"$route\"}) * on (route) group_left (name) topk by (route) (1, max by (route, name) (muster_route_info{namespace=~\"$namespace\", job=~\"$job\"}))",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Ingestion",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Ingestion requests by Integration and outcome",
      "description": "Requests to the ingestion endpoint per second by Integration and outcome; requests whose token matches no Integration are shown as unknown token.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (integration, outcome) (rate(muster_ingest_requests_total{namespace=~\"$namespace\", job=~\"$job\", integration=~\"$integration\"}[$__rate_interval])) * on (integration) group_left (name) topk by (integration) (1, max by (integration, name) (muster_integration_info{namespace=~\"$namespace\", job=~\"$job\"}))",
          "legendFormat": "{{name}} {{outcome}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(muster_ingest_requests_total{namespace=~\"$namespace\", job=~\"$job\", integration=\"unknown\"}[$__rate_interval]))",
          "legendFormat": "unknown token {{outcome}}",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Processing delay p95 by Integration",
      "description": "95th percentile of the time from storing a Snapshot to processing it, by Integration.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
