{
  "name": "muster-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "orval --config orval.config.ts && tsr generate",
    "lint:spec": "redocly lint ../api/openapi.yaml --config ../.redocly.yaml",
    "licenses": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@redocly/cli": "2.57.0",
    "@tanstack/router-cli": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "msw": "3.0.1",
    "orval": "8.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.9.1"
}
